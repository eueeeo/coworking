<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Коворкинг</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('coworking_theme');
                if (theme === 'dark' || (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
</head>
<body>

    <header class="site-header">
        <nav class="site-nav">
            <a class="site-logo" asp-page="/Index">
                <span class="logo-mark">
                    <svg viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                        <path d="M4,20 C3,18 2,14 3,10 C4,6 7,3 12,3 C17,3 20,6 21,10 C22,14 21,18 20,20 C18,22 15,23 12,22 C9,22 6,22 4,20 Z"/>
                        <ellipse cx="12" cy="11" rx="4" ry="3.5" fill="#0d0d0d"/>
                        <ellipse cx="12" cy="11" rx="1.8" ry="1.8" fill="white"/>
                    </svg>
                </span>
                КОВОРКИНГ
            </a>

            <ul class="site-nav-links" id="navLinks">
                <li><a href="/#catalog">Каталог</a></li>
                <li><a href="/#spaces">Форматы</a></li>
                <li><a href="/#about">О коворкинге</a></li>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="d-md-none"><hr style="border-color:var(--border);margin:.5rem 0;" /></li>
                    <li class="d-md-none"><a asp-page="/Bookings/Index">Мои брони</a></li>
                    @if (User.IsInRole("Администратор"))
                    {
                        <li class="d-md-none"><a asp-page="/Admin/Bookings/Index" class="nav-admin-link">Панель управления</a></li>
                    }
                    <li class="d-md-none"><a asp-page="/Account/Logout" class="text-danger">Выйти (@User.Identity.Name)</a></li>
                }
                <li class="d-md-none nav-theme-item">
                    <button type="button" class="theme-toggle-btn js-theme-toggle w-100 justify-content-center" aria-label="Переключить тему" title="Переключить тему">
                        <span class="theme-toggle-icon">
                            <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                            </svg>
                            <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="5"></circle>
                                <line x1="12" y1="1" x2="12" y2="3"></line>
                                <line x1="12" y1="21" x2="12" y2="23"></line>
                                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                <line x1="1" y1="12" x2="3" y2="12"></line>
                                <line x1="21" y1="12" x2="23" y2="12"></line>
                                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                            </svg>
                        </span>
                        <span class="theme-toggle-text">Тёмная тема</span>
                    </button>
                </li>
            </ul>

            <div class="site-nav-auth">
                <button type="button" class="theme-toggle-btn js-theme-toggle d-none d-md-inline-flex" aria-label="Переключить тему" title="Переключить тему">
                    <span class="theme-toggle-icon">
                        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                        </svg>
                        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                        </svg>
                    </span>
                </button>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    var fullName = User.Identity.Name ?? "Пользователь";
                    var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    var shortName = nameParts.Length > 1 ? nameParts[1] : (nameParts.Length > 0 ? nameParts[0] : "Профиль");
                    var initial = shortName.Length > 0 ? char.ToUpper(shortName[0]).ToString() : "U";

                    <div class="dropdown d-none d-md-block user-menu-dropdown">
                        <button class="user-menu-btn dropdown-toggle" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="user-avatar-circle">@initial</span>
                            <span class="user-menu-name">@shortName</span>
                            @if (User.IsInRole("Администратор"))
                            {
                                <span class="user-role-badge">Администратор</span>
                            }
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end user-dropdown-panel" aria-labelledby="userMenuBtn">
                            <li class="dropdown-header">
                                <div class="fw-bold">@fullName</div>
                                <div class="user-subtext">@(User.IsInRole("Администратор") ? "Администратор сервиса" : "Клиент коворкинга")</div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" asp-page="/Bookings/Index">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    Мои брони
                                </a>
                            </li>
                            @if (User.IsInRole("Администратор"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-page="/Admin/Bookings/Index">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                        Панель управления
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-page="/Account/Logout">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                    Выйти
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-page="/Account/Login" class="btn-outline-ink btn-outline-ink-sm">Войти</a>
                    <a asp-page="/Account/Register" class="btn-ink btn-ink-sm">Регистрация</a>
                }
            </div>

            <button class="nav-toggle" id="navToggle" aria-label="Меню">
                <span></span><span></span><span></span>
            </button>
        </nav>
    </header>

    <div class="site-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container py-4">
            <div class="row g-4 text-start">
                <div class="col-md-5">
                    <div class="fw-bold mb-2" style="letter-spacing: .5px; font-size: 1.05rem; color: var(--ink);">
                        КОВОРКИНГ
                    </div>
                    <p class="small text-muted mb-2" style="max-width: 320px; line-height: 1.5;">
                        Творческое арт-пространство в центре города: оборудованные рабочие места, тихие капсулы и залы для переговоров с почасовой тарификацией.
                    </p>
                </div>
                <div class="col-md-3">
                    <div class="fw-bold small mb-2 text-uppercase" style="letter-spacing: .5px;">Разделы сайта</div>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-1">
                        <li><a href="/#catalog" class="text-muted text-decoration-none">Каталог мест</a></li>
                        <li><a href="/#spaces" class="text-muted text-decoration-none">Форматы залов</a></li>
                        <li><a href="/#about" class="text-muted text-decoration-none">О пространстве</a></li>
                        <li><a asp-page="/Privacy" class="text-muted text-decoration-none">Правила и конфиденциальность</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <div class="fw-bold small mb-2 text-uppercase" style="letter-spacing: .5px;">Контакты и локация</div>
                    <div class="small text-muted mb-1">г. Минск, ул. Октябрьская, 19</div>
                    <div class="small text-muted mb-1">+375 (29) 100-20-30</div>
                    <div class="small text-muted mb-1">info@coworking.by</div>
                    <div class="small fw-bold mt-2" style="color: var(--accent);">Круглосуточно 24/7 для резидентов</div>
                </div>
            </div>
            <hr style="border-color: var(--border); margin: 1.5rem 0 1rem;" />
            <div class="d-flex justify-content-between align-items-center flex-wrap small text-muted">
                <div>&copy; 2026 Коворкинг. Все права защищены.</div>
                <div><a asp-page="/Privacy" class="text-muted">Политика конфиденциальности</a></div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            var toggle = document.getElementById('navToggle');
            var links = document.getElementById('navLinks');
            if (toggle && links) {
                toggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    links.classList.toggle('open');
                });

                var navAnchors = links.querySelectorAll('a');
                navAnchors.forEach(function (a) {
                    a.addEventListener('click', function () {
                        links.classList.remove('open');
                    });
                });

                document.addEventListener('click', function (e) {
                    if (!links.contains(e.target) && !toggle.contains(e.target)) {
                        links.classList.remove('open');
                    }
                });
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>