@page
@model Coworking.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="admin-header-wrap">
    <div>
        <h2 class="page-title">Пользователи</h2>
        <p class="page-sub">Учетные записи пользователей и управление доступом</p>
    </div>
</div>

<partial name="_AdminSubnav" model='"Users"' />

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert-custom alert-success-custom">
        <span>@Model.SuccessMessage</span>
        <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:inherit;">&times;</button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-custom alert-danger-custom">
        <span>@Model.ErrorMessage</span>
        <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:inherit;">&times;</button>
    </div>
}

<div class="filter-panel mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label asp-for="SearchTerm" class="filter-label">Поиск по ФИО, Email или телефону</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Например: Иванов или ivanov@example.com" />
        </div>
        <div class="col-md-3">
            <label asp-for="FilterActive" class="filter-label">Статус учетной записи</label>
            <select asp-for="FilterActive" class="filter-select" style="width:100%;">
                <option value="">Все статусы</option>
                <option value="true">Только активные</option>
                <option value="false">Только заблокированные</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn-ink flex-fill">Найти</button>
            <a asp-page="/Admin/Users/Index" class="btn-outline-ink">Сбросить</a>
        </div>
    </form>
</div>

@if (Model.UsersList.Count == 0)
{
    <div class="empty-state">
        <h5>Пользователей не найдено</h5>
        <p>По заданным параметрам поиска пользователей не обнаружено.</p>
        <a asp-page="/Admin/Users/Index" class="btn-ink">Сбросить фильтры</a>
    </div>
}
else
{
    <p class="results-count" style="margin-bottom: .75rem;">
        Найдено пользователей: <strong>@Model.UsersList.Count</strong>
    </p>

    <div class="data-table-wrap">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">ID</th>
                        <th>ФИО пользователя</th>
                        <th>Контакты</th>
                        <th>Роль</th>
                        <th>Бронирований</th>
                        <th>Статус</th>
                        <th style="width: 260px; text-align: right;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.UsersList)
                    {
                        <tr>
                            <td>
                                <span class="booking-id">#@u.Id</span>
                            </td>
                            <td>
                                <div style="font-weight: 800; color: var(--ink);">
                                    @u.FullName
                                    @if (u.IsCurrentAdmin)
                                    {
                                        <span class="badge bg-dark text-white ms-1" style="font-size: .65rem;">Вы</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div>@u.Email</div>
                                <small style="color: var(--muted);">@u.Phone</small>
                            </td>
                            <td>
                                @if (u.RoleName == "Администратор")
                                {
                                    <span class="badge-role-admin">Администратор</span>
                                }
                                else
                                {
                                    <span class="badge-role-client">Клиент</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@u.TotalBookingsCount заявок</span>
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge-active">Активен</span>
                                }
                                else
                                {
                                    <span class="badge-blocked">Заблокирован</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                @if (u.IsCurrentAdmin)
                                {
                                    <span class="text-muted small">Текущая сессия</span>
                                }
                                else
                                {
                                    <div class="d-inline-flex gap-1">
                                        <form method="post" asp-page-handler="ToggleActive" asp-route-id="@u.Id" class="d-inline">
                                            <button type="submit" class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") btn-sm">
                                                @(u.IsActive ? "Блокировать" : "Разблокировать")
                                            </button>
                                        </form>

                                        <form method="post" asp-page-handler="ToggleRole" asp-route-id="@u.Id"
                                              onsubmit="return confirm('Изменить системную роль пользователя «@u.Email»?');" class="d-inline">
                                            <button type="submit" class="btn btn-outline-secondary btn-sm" title="Сменить роль (Клиент / Администратор)">
                                                @(u.RoleName == "Администратор" ? "Снять админа" : "Сделать админом")
                                            </button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}