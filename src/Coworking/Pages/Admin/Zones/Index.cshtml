@page
@model Coworking.Pages.Admin.Zones.IndexModel
@{
    ViewData["Title"] = "Управление зонами";
    var isFormOpen = Model.EditZoneId.HasValue || !ViewData.ModelState.IsValid;
}

<div class="admin-header-wrap">
    <div>
        <h2 class="page-title">Зоны коворкинга</h2>
        <p class="page-sub">Зонирование рабочих пространств по этажам</p>
    </div>
</div>

<partial name="_AdminSubnav" model='"Zones"' />

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert-custom alert-success-custom">
        <span>@Model.SuccessMessage</span>
        <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:inherit;">&times;</button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-custom alert-danger-custom">
        <span>@Model.ErrorMessage</span>
        <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:inherit;">&times;</button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <button type="button" class="btn-ink" onclick="toggleAdminPanel(this, 'zoneFormPanel')">
        @(isFormOpen ? "Скрыть форму" : "+ Добавить зону")
    </button>
</div>

<div id="zoneFormPanel" class="admin-card-form mb-4" style="@(isFormOpen ? "" : "display:none;")">
    <h4 class="admin-card-title">
        @(Model.EditZoneId.HasValue ? "Редактирование зоны" : "Новая зона")
    </h4>
    <form method="post" asp-page-handler="Save">
        @if (Model.EditZoneId.HasValue)
        {
            <input type="hidden" asp-for="EditZoneId" />
        }
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Input.FloorId" class="form-label-custom">Этаж *</label>
                <select asp-for="Input.FloorId" asp-items="Model.FloorList" class="form-select">
                    <option value="">-- Выберите этаж --</option>
                </select>
                <span asp-validation-for="Input.FloorId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Name" class="form-label-custom">Название зоны *</label>
                <input asp-for="Input.Name" class="form-control" placeholder="Северный рабочий зал" />
                <span asp-validation-for="Input.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Input.Description" class="form-label-custom">Описание</label>
                <input asp-for="Input.Description" class="form-control" placeholder="Особенности зоны, освещение, уровень шума" />
                <span asp-validation-for="Input.Description" class="text-danger small"></span>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn-ink">
                @(Model.EditZoneId.HasValue ? "Сохранить изменения" : "Добавить зону")
            </button>
            @if (Model.EditZoneId.HasValue)
            {
                <a asp-page="/Admin/Zones/Index" class="btn-outline-ink">Отмена</a>
            }
        </div>
    </form>
</div>

<div class="filter-panel mb-3">
    <form method="get" class="d-flex align-items-center gap-2">
        <label asp-for="FilterFloorId" class="filter-label mb-0">Фильтр по этажу:</label>
        <select asp-for="FilterFloorId" asp-items="Model.FloorList" class="filter-select" onchange="this.form.submit()">
            <option value="">Все этажи</option>
        </select>
        @if (Model.FilterFloorId.HasValue)
        {
            <a asp-page="/Admin/Zones/Index" class="btn-outline-ink btn-sm">Сбросить</a>
        }
    </form>
</div>

<div class="data-table-wrap">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Название зоны</th>
                    <th>Этаж</th>
                    <th>Описание</th>
                    <th>Рабочих мест</th>
                    <th style="width: 170px; text-align: right;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var zone in Model.Zones)
                {
                    <tr>
                        <td>
                            <strong style="color: var(--ink);">@zone.Name</strong>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@zone.FloorName</span>
                        </td>
                        <td>
                            <span style="color: var(--muted); font-size: .88rem;">
                                @(string.IsNullOrEmpty(zone.Description) ? "—" : zone.Description)
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@zone.WorkspacesCount мест</span>
                        </td>
                        <td style="text-align: right;">
                            <div class="d-inline-flex gap-1">
                                <a asp-page="/Admin/Zones/Index" asp-route-editId="@zone.Id" class="btn btn-outline-primary btn-sm">
                                    Изменить
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@zone.Id"
                                      onsubmit="return confirm('Вы действительно хотите удалить зону «@zone.Name»?');" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Удалить
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}