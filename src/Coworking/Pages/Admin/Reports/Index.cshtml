@page
@model Coworking.Pages.Admin.Reports.IndexModel
@{
    ViewData["Title"] = "Отчетность по выручке и загруженности";
}

<div class="admin-header-wrap">
    <div>
        <h2 class="page-title">Аналитический отчет и выручка</h2>
        <p class="page-sub">Сводные показатели бронирований и финансовая статистика</p>
    </div>
</div>

<partial name="_AdminSubnav" model='"Reports"' />

<div class="filter-panel mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label asp-for="DateFrom" class="filter-label">Период с даты</label>
            <input asp-for="DateFrom" type="date" class="form-control" />
        </div>
        <div class="col-md-4">
            <label asp-for="DateTo" class="filter-label">Период по дату</label>
            <input asp-for="DateTo" type="date" class="form-control" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn-ink flex-fill">Сформировать</button>
            <a asp-page="/Admin/Reports/Index" asp-page-handler="ExportCsv"
               asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
               asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
               class="btn-outline-ink">Экспорт CSV</a>
            <a asp-page="/Admin/Reports/Index" class="btn-outline-ink">Сброс</a>
        </div>
    </form>
</div>

<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-num accent">@Model.TotalRevenue.ToString("0.00") BYN</div>
        <div class="stat-label">Общая выручка</div>
    </div>
    <div class="stat-card">
        <div class="stat-num">@Model.SuccessfulBookings</div>
        <div class="stat-label">Успешных броней (@Model.TotalBookings всего)</div>
    </div>
    <div class="stat-card">
        <div class="stat-num">@Model.TotalHours.ToString("0.#") ч.</div>
        <div class="stat-label">Суммарное время аренды</div>
    </div>
    <div class="stat-card">
        <div class="stat-num">@Model.AverageBookingCost.ToString("0.00") BYN</div>
        <div class="stat-label">Средний чек брони</div>
    </div>
</div>

<div class="mb-4">
    <h3 class="page-title" style="font-size: 1.25rem; margin-bottom: .75rem;">
        Выручка и спрос по типам рабочих мест
    </h3>
    <div class="data-table-wrap">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Тип рабочего места</th>
                        <th>Тариф</th>
                        <th>Бронирований</th>
                        <th>Часов аренды</th>
                        <th>Выручка</th>
                        <th style="width: 200px;">Доля в выручке</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.TypeReports)
                    {
                        <tr>
                            <td>
                                <strong style="color: var(--ink);">@t.TypeName</strong>
                            </td>
                            <td>
                                <span>@t.PricePerHour.ToString("0.00") BYN/час</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@t.BookingsCount заявок</span>
                            </td>
                            <td>
                                <span style="font-weight: 600;">@t.TotalHours ч.</span>
                            </td>
                            <td>
                                <strong class="info-price" style="font-size: 1rem;">@t.Revenue.ToString("0.00") BYN</strong>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress flex-grow-1" style="height: 8px;">
                                        <div class="progress-bar bg-danger" role="progressbar" style="width: @t.SharePercent%"></div>
                                    </div>
                                    <span class="small fw-bold">@t.SharePercent%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div>
    <h3 class="page-title" style="font-size: 1.25rem; margin-bottom: .75rem;">
        Загруженность конкретных рабочих мест
    </h3>
    <div class="data-table-wrap">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 90px;">Место</th>
                        <th>Локация</th>
                        <th>Тип места</th>
                        <th>Бронирований</th>
                        <th>Отработано часов</th>
                        <th>Принесенная выручка</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ws in Model.WorkspaceReports)
                    {
                        <tr>
                            <td>
                                <strong style="font-size: 1.15rem; color: var(--ink);">@ws.Number</strong>
                            </td>
                            <td>
                                <span>@ws.Location</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@ws.TypeName</span>
                            </td>
                            <td>
                                <span style="font-weight: 700;">@ws.BookingsCount</span>
                            </td>
                            <td>
                                <span>@ws.TotalHours ч.</span>
                            </td>
                            <td>
                                <strong style="color: var(--ink);">@ws.Revenue.ToString("0.00") BYN</strong>
                            </td>
                            <td>
                                @if (ws.IsActive)
                                {
                                    <span class="badge-active">Активно</span>
                                }
                                else
                                {
                                    <span class="badge-blocked">Отключено</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>