@page
@model Coworking.Pages.Admin.Workspaces.IndexModel
@{
    ViewData["Title"] = "Управление рабочими местами";
    var isFormOpen = Model.EditWorkspaceId.HasValue || !ViewData.ModelState.IsValid;
}

<div class="admin-header-wrap">
    <div>
        <h2 class="page-title">Рабочие места</h2>
        <p class="page-sub">Список рабочих мест, оснащение и доступность для бронирования</p>
    </div>
</div>

<partial name="_AdminSubnav" model='"Workspaces"' />

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert-custom alert-success-custom">
        <span>@Model.SuccessMessage</span>
        <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:inherit;">&times;</button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-custom alert-danger-custom">
        <span>@Model.ErrorMessage</span>
        <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:inherit;">&times;</button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <button type="button" class="btn-ink" onclick="toggleAdminPanel(this, 'wsFormPanel')">
        @(isFormOpen ? "Скрыть форму" : "+ Добавить рабочее место")
    </button>
</div>

<div id="wsFormPanel" class="admin-card-form mb-4" style="@(isFormOpen ? "" : "display:none;")">
    <h4 class="admin-card-title">
        @(Model.EditWorkspaceId.HasValue ? "Редактирование рабочего места" : "Новое рабочее место")
    </h4>
    <form method="post" asp-page-handler="Save">
        @if (Model.EditWorkspaceId.HasValue)
        {
            <input type="hidden" asp-for="EditWorkspaceId" />
        }
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Input.ZoneId" class="form-label-custom">Зона расположения *</label>
                <select asp-for="Input.ZoneId" asp-items="Model.ZoneList" class="form-select">
                    <option value="">-- Выберите зону --</option>
                </select>
                <span asp-validation-for="Input.ZoneId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.TypeId" class="form-label-custom">Тип (тариф) *</label>
                <select asp-for="Input.TypeId" asp-items="Model.TypeList" class="form-select">
                    <option value="">-- Выберите тип места --</option>
                </select>
                <span asp-validation-for="Input.TypeId" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.Number" class="form-label-custom">Номер места *</label>
                <input asp-for="Input.Number" class="form-control" placeholder="Например: М-101" />
                <span asp-validation-for="Input.Number" class="text-danger small"></span>
            </div>
            <div class="col-md-3 d-flex align-items-center pt-3">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" asp-for="Input.IsActive" id="isActiveSwitch">
                    <label class="form-check-label fw-bold" for="isActiveSwitch">Активно для аренды</label>
                </div>
            </div>
            <div class="col-md-12">
                <label asp-for="Input.Description" class="form-label-custom">Описание особенностей места</label>
                <input asp-for="Input.Description" class="form-control" placeholder="У окна, эргономичное кресло, тихое место" />
                <span asp-validation-for="Input.Description" class="text-danger small"></span>
            </div>

            <div class="col-md-12">
                <label class="form-label-custom mb-2">Оснащение и удобства места:</label>
                <div class="row g-2 p-3 rounded" style="background: var(--bg); border: 1.5px solid var(--border);">
                    @foreach (var am in Model.AvailableAmenities)
                    {
                        var isChecked = Model.SelectedAmenityIds.Contains(am.Id);
                        <div class="col-md-4 col-sm-6">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedAmenityIds" value="@am.Id" 
                                       id="amenity_@am.Id" @(isChecked ? "checked" : "") />
                                <label class="form-check-label small" for="amenity_@am.Id">
                                    <strong>@am.Name</strong> <span class="text-muted">(@am.CategoryName)</span>
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn-ink">
                @(Model.EditWorkspaceId.HasValue ? "Сохранить изменения" : "Добавить место")
            </button>
            @if (Model.EditWorkspaceId.HasValue)
            {
                <a asp-page="/Admin/Workspaces/Index" class="btn-outline-ink">Отмена</a>
            }
        </div>
    </form>
</div>

<div class="filter-panel mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label asp-for="FilterFloorId" class="filter-label">Этаж</label>
            <select asp-for="FilterFloorId" asp-items="Model.FloorList" class="filter-select" style="width:100%;">
                <option value="">Все этажи</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="FilterZoneId" class="filter-label">Зона</label>
            <select asp-for="FilterZoneId" asp-items="Model.ZoneList" class="filter-select" style="width:100%;">
                <option value="">Все зоны</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="FilterTypeId" class="filter-label">Тип места</label>
            <select asp-for="FilterTypeId" asp-items="Model.TypeList" class="filter-select" style="width:100%;">
                <option value="">Все типы</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn-ink flex-fill">Применить</button>
            <a asp-page="/Admin/Workspaces/Index" class="btn-outline-ink">Сброс</a>
        </div>
    </form>
</div>

<p class="results-count" style="margin-bottom: .75rem;">
    Всего мест в реестре: <strong>@Model.Workspaces.Count</strong>
</p>

<div class="data-table-wrap">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 100px;">Номер</th>
                    <th>Локация</th>
                    <th>Тип и тариф</th>
                    <th>Удобства</th>
                    <th>Статус</th>
                    <th style="width: 220px; text-align: right;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ws in Model.Workspaces)
                {
                    <tr>
                        <td>
                            <strong style="font-size: 1.15rem; color: var(--ink);">@ws.Number</strong>
                        </td>
                        <td>
                            <div style="font-weight: 700;">@ws.ZoneName</div>
                            <small style="color: var(--muted);">@ws.FloorName</small>
                        </td>
                        <td>
                            <div style="font-weight: 700;">@ws.TypeName</div>
                            <span class="info-price" style="font-size: .95rem;">@ws.PricePerHour.ToString("0.00") BYN/час</span>
                        </td>
                        <td>
                            @if (ws.Amenities.Any())
                            {
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var a in ws.Amenities)
                                    {
                                        <span class="amenity-tag">@a</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="small text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (ws.IsActive)
                            {
                                <span class="badge-active">Активно</span>
                            }
                            else
                            {
                                <span class="badge-blocked">Отключено</span>
                            }
                        </td>
                        <td style="text-align: right;">
                            <div class="d-inline-flex gap-1">
                                <a asp-page="/Admin/Workspaces/Index" asp-route-editId="@ws.Id" class="btn btn-outline-primary btn-sm">
                                    Изменить
                                </a>
                                <form method="post" asp-page-handler="ToggleActive" asp-route-id="@ws.Id" class="d-inline">
                                    <button type="submit" class="btn @(ws.IsActive ? "btn-outline-secondary" : "btn-outline-success") btn-sm">
                                        @(ws.IsActive ? "Отключить" : "Включить")
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@ws.Id"
                                      onsubmit="return confirm('Удалить рабочее место «@ws.Number»?');" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Удалить
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}