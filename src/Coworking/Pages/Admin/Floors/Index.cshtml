@page
@model Coworking.Pages.Admin.Floors.IndexModel
@{
    ViewData["Title"] = "Управление этажами";
    var isFormOpen = Model.EditFloorId.HasValue || !ViewData.ModelState.IsValid;
}

<div class="admin-header-wrap">
    <div>
        <h2 class="page-title">Этажи</h2>
        <p class="page-sub">Список этажей и их описание</p>
    </div>
</div>

<partial name="_AdminSubnav" model='"Floors"' />

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert-custom alert-success-custom">
        <span>@Model.SuccessMessage</span>
        <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:inherit;">&times;</button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-custom alert-danger-custom">
        <span>@Model.ErrorMessage</span>
        <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:inherit;">&times;</button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <button type="button" class="btn-ink" onclick="toggleAdminPanel(this, 'floorFormPanel')">
        @(isFormOpen ? "Скрыть форму" : "+ Добавить этаж")
    </button>
</div>

<div id="floorFormPanel" class="admin-card-form mb-4" style="@(isFormOpen ? "" : "display:none;")">
    <h4 class="admin-card-title">
        @(Model.EditFloorId.HasValue ? "Редактирование этажа" : "Новый этаж")
    </h4>
    <form method="post" asp-page-handler="Save">
        @if (Model.EditFloorId.HasValue)
        {
            <input type="hidden" asp-for="EditFloorId" />
        }
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Input.Number" class="form-label-custom">Номер этажа *</label>
                <input asp-for="Input.Number" class="form-control" type="number" placeholder="1" />
                <span asp-validation-for="Input.Number" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Name" class="form-label-custom">Название этажа *</label>
                <input asp-for="Input.Name" class="form-control" placeholder="1 этаж (Зона встречи и отдыха)" />
                <span asp-validation-for="Input.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Input.Description" class="form-label-custom">Описание</label>
                <input asp-for="Input.Description" class="form-control" placeholder="Краткое описание этажа" />
                <span asp-validation-for="Input.Description" class="text-danger small"></span>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn-ink">
                @(Model.EditFloorId.HasValue ? "Сохранить изменения" : "Добавить этаж")
            </button>
            @if (Model.EditFloorId.HasValue)
            {
                <a asp-page="/Admin/Floors/Index" class="btn-outline-ink">Отмена</a>
            }
        </div>
    </form>
</div>

<div class="data-table-wrap">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width: 80px;">Номер</th>
                    <th>Название</th>
                    <th>Описание</th>
                    <th>Зон</th>
                    <th>Рабочих мест</th>
                    <th style="width: 170px; text-align: right;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var floor in Model.Floors)
                {
                    <tr>
                        <td>
                            <strong style="font-size: 1.1rem; color: var(--ink);">@floor.Number</strong>
                        </td>
                        <td>
                            <div style="font-weight: 700;">@floor.Name</div>
                        </td>
                        <td>
                            <span style="color: var(--muted); font-size: .88rem;">
                                @(string.IsNullOrEmpty(floor.Description) ? "—" : floor.Description)
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@floor.ZonesCount зон</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@floor.WorkspacesCount мест</span>
                        </td>
                        <td style="text-align: right;">
                            <div class="d-inline-flex gap-1">
                                <a asp-page="/Admin/Floors/Index" asp-route-editId="@floor.Id" class="btn btn-outline-primary btn-sm">
                                    Изменить
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@floor.Id"
                                      onsubmit="return confirm('Вы действительно хотите удалить этаж «@floor.Name»?');" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Удалить
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}