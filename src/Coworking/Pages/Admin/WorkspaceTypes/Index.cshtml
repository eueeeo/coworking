@page
@model Coworking.Pages.Admin.WorkspaceTypes.IndexModel
@{
    ViewData["Title"] = "Управление типами и тарифами";
    var isFormOpen = Model.EditTypeId.HasValue || !ViewData.ModelState.IsValid;
}

<div class="admin-header-wrap">
    <div>
        <h2 class="page-title">Типы и тарифы</h2>
        <p class="page-sub">Категории рабочих мест и почасовая стоимость аренды</p>
    </div>
</div>

<partial name="_AdminSubnav" model='"Types"' />

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert-custom alert-success-custom">
        <span>@Model.SuccessMessage</span>
        <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:inherit;">&times;</button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert-custom alert-danger-custom">
        <span>@Model.ErrorMessage</span>
        <button type="button" onclick="this.parentElement.remove()" style="background:none;border:none;cursor:pointer;font-size:1.1rem;color:inherit;">&times;</button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <button type="button" class="btn-ink" onclick="toggleAdminPanel(this, 'typeFormPanel')">
        @(isFormOpen ? "Скрыть форму" : "+ Добавить тип места")
    </button>
</div>

<div id="typeFormPanel" class="admin-card-form mb-4" style="@(isFormOpen ? "" : "display:none;")">
    <h4 class="admin-card-title">
        @(Model.EditTypeId.HasValue ? "Редактирование типа и тарифа" : "Новый тип места")
    </h4>
    <form method="post" asp-page-handler="Save">
        @if (Model.EditTypeId.HasValue)
        {
            <input type="hidden" asp-for="EditTypeId" />
        }
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Input.Name" class="form-label-custom">Название типа места *</label>
                <input asp-for="Input.Name" class="form-control" placeholder="Стандартное место" />
                <span asp-validation-for="Input.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Input.PricePerHour" class="form-label-custom">Тариф (BYN/час) *</label>
                <input asp-for="Input.PricePerHour" class="form-control" type="number" step="0.5" min="0" placeholder="10.00" />
                <span asp-validation-for="Input.PricePerHour" class="text-danger small"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Input.Description" class="form-label-custom">Описание типа</label>
                <input asp-for="Input.Description" class="form-control" placeholder="Краткое описание преимуществ и назначения" />
                <span asp-validation-for="Input.Description" class="text-danger small"></span>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn-ink">
                @(Model.EditTypeId.HasValue ? "Сохранить изменения" : "Добавить тип места")
            </button>
            @if (Model.EditTypeId.HasValue)
            {
                <a asp-page="/Admin/WorkspaceTypes/Index" class="btn-outline-ink">Отмена</a>
            }
        </div>
    </form>
</div>

<div class="data-table-wrap">
    <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Тип рабочего места</th>
                    <th>Тариф (в час)</th>
                    <th>Описание</th>
                    <th>Всего мест</th>
                    <th style="width: 170px; text-align: right;">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var type in Model.Types)
                {
                    <tr>
                        <td>
                            <strong style="color: var(--ink);">@type.Name</strong>
                        </td>
                        <td>
                            <span class="info-price" style="font-size: 1.15rem;">
                                @type.PricePerHour.ToString("0.00") BYN/час
                            </span>
                        </td>
                        <td>
                            <span style="color: var(--muted); font-size: .88rem;">
                                @(string.IsNullOrEmpty(type.Description) ? "—" : type.Description)
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@type.WorkspacesCount мест</span>
                        </td>
                        <td style="text-align: right;">
                            <div class="d-inline-flex gap-1">
                                <a asp-page="/Admin/WorkspaceTypes/Index" asp-route-editId="@type.Id" class="btn btn-outline-primary btn-sm">
                                    Изменить
                                </a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@type.Id"
                                      onsubmit="return confirm('Вы действительно хотите удалить тип «@type.Name»?');" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Удалить
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}