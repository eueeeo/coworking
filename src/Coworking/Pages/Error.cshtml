@page
@model ErrorModel
@{
    ViewData["Title"] = "Произошла ошибка";
}

<div class="empty-state" style="margin: 3rem auto; max-width: 520px; background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 3rem 2rem; box-shadow: var(--shadow);">
    <h3 style="font-weight: 800; margin-bottom: .5rem; color: var(--ink);">Что-то пошло не так</h3>
    <p style="color: var(--muted); margin-bottom: 1.5rem; font-size: .95rem; line-height: 1.5;">
        При обработке вашего запроса произошла непредвиденная ошибка. Мы уже работаем над её устранением. Пожалуйста, вернитесь на главную страницу или повторите действие через пару минут.
    </p>

    @if (Model.ShowRequestId)
    {
        <div style="background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: .5rem .75rem; margin-bottom: 1.5rem; font-size: .8rem; color: var(--muted); word-break: break-all;">
            Код обращения: <code>@Model.RequestId</code>
        </div>
    }

    <div class="d-flex justify-content-center gap-2">
        <a asp-page="/Index" class="btn-ink">На главную страницу</a>
        <a href="javascript:history.back()" class="btn-outline-ink">Назад</a>
    </div>
</div>