@page
@model Coworking.Pages.Account.ResendConfirmationModel
@{
    ViewData["Title"] = "Повторная отправка подтверждения";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-header">
            <div>
                <h4 class="auth-title">Ссылка подтверждения</h4>
                <p class="auth-sub">Запрос нового письма для активации аккаунта</p>
            </div>
        </div>

        <div class="auth-body">
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert-custom alert-success-custom mb-4">
                    @Model.SuccessMessage
                </div>

                @if (Model.IsAlreadyConfirmed)
                {
                    <div class="mt-3">
                        <a asp-page="/Account/Login" class="btn-ink" style="width:100%;">Войти в систему</a>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(Model.WarningMessage))
            {
                <div class="alert-custom alert-warning-custom mb-4">
                    @Model.WarningMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert-custom alert-danger-custom mb-4">
                    @Model.ErrorMessage
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert-custom alert-danger-custom mb-4" role="alert"></div>
            }

            @if (string.IsNullOrEmpty(Model.SuccessMessage) || !Model.IsAlreadyConfirmed)
            {
                <form method="post">
                    <p class="small text-muted mb-3">
                        Введите адрес электронной почты, указанный при регистрации. Мы создадим новую ссылку подтверждения, а предыдущая ссылка станет недействительной.
                    </p>

                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label-custom">Электронная почта</label>
                        <input asp-for="Input.Email" class="form-control-custom" autocomplete="email" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-ink" style="width:100%;">Отправить ссылку</button>
                </form>
            }
        </div>

        <div class="auth-footer text-center">
            Вспомнили данные? <a asp-page="/Account/Login">Вернуться ко входу</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}